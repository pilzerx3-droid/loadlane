{
  "name": "loadlane",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "infra:up": "node scripts/infra.ts up",
    "infra:down": "node scripts/infra.ts down",
    "infra:reset": "node scripts/infra.ts reset",
    "infra:logs": "node scripts/infra.ts logs",
    "infra:check": "node scripts/check-infra.ts",
    "db:migrate": "pnpm --filter @loadlane/db run db:migrate",
    "db:generate": "pnpm --filter @loadlane/db run db:generate",
    "db:check": "pnpm --filter @loadlane/db run db:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
