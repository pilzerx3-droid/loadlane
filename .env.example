# Copy to .env for local development. All values below are local-only defaults, never real secrets.

# PostgreSQL + PostGIS (infra/docker-compose.yml)
POSTGRES_USER=loadlane
POSTGRES_PASSWORD=loadlane_dev_only
POSTGRES_DB=loadlane
POSTGRES_PORT=5432
# DATABASE_URL: owner role, runs migrations only (pnpm db:migrate). It is not subject to the app policies.
DATABASE_URL=postgres://loadlane:loadlane_dev_only@127.0.0.1:5432/loadlane
# APP_DATABASE_URL: role the application and the tests connect with. It is subject to row-level security.
# The role is created by infra/postgres/init on first start; after changing the password run pnpm infra:reset.
APP_DB_PASSWORD=loadlane_app_dev_only
APP_DATABASE_URL=postgres://loadlane_app:loadlane_app_dev_only@127.0.0.1:5432/loadlane

# Valkey (Redis-compatible, used by BullMQ)
VALKEY_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# SeaweedFS S3 gateway. Keys must match infra/seaweedfs/s3.json.
S3_PORT=8333
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=loadlane_dev
S3_SECRET_ACCESS_KEY=loadlane_dev_secret
# Bucket for documents. The API creates it on start when it does not exist (production: create it yourself).
S3_BUCKET=loadlane-documents

# Mailpit (local mail catcher in infra/docker-compose.yml): inbox at http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Outgoing e-mail (ADR 0021). Any SMTP server works. Without MAIL_SMTP_URL sending answers 503.
# Local: Mailpit. Production: your provider's SMTP URL, for example smtps://user:password@smtp.example.com:465
MAIL_SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Loadlane <no-reply@loadlane.local>

# Address lookup and routing (ADR 0021): OpenRouteService, free key from openrouteservice.org. Without it
# the lookup and ETA features say they are not configured. ORS_BASE_URL only changes for tests.
# ORS_API_KEY=replace-with-your-openrouteservice-key
# ORS_BASE_URL=https://api.heigit.org

# Map background (apps/web): a MapLibre style URL. Default: the public OpenFreeMap style (OpenStreetMap
# data, no key). MAP_EXTRA_ORIGINS lists other hosts a custom style loads tiles, sprites or fonts from.
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# MAP_EXTRA_ORIGINS=

# Outgoing webhooks (ADR 0022). Key for the signing secrets: 32 random bytes, base64. Create one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The API and the worker need the same key. Without it webhooks are off. Allow http/private targets only locally.
# WEBHOOK_ENCRYPTION_KEY=
# WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# Sign-in provider: ZITADEL Cloud, US region (docs/dev-setup-zitadel.md). These are placeholders:
# sign-in does not work until you put the real values of your own instance into your local .env.
OIDC_ISSUER=https://your-instance.zitadel.cloud
OIDC_CLIENT_ID=replace-with-the-client-id
OIDC_AUDIENCE=replace-with-the-project-id

# API (apps/api)
API_HOST=127.0.0.1
API_PORT=4000

# Web (apps/web)
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:4000

# API behavior (apps/api). Defaults shown.
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=120
# OPENAPI_ENABLED=true   # default: on, except when NODE_ENV=production
# How many organizations one person may create (self-service)
MAX_ORGANIZATIONS_PER_USER=3

# Tracing (apps/api). none (default), console (spans printed to the terminal) or otlp (OTLP/HTTP collector;
# the endpoint comes from the standard OTEL_EXPORTER_OTLP_ENDPOINT, default http://localhost:4318).
OTEL_TRACES_EXPORTER=none

# Optional: a Redis/Valkey URL so all API instances share one rate limit per client address.
# Without it each instance counts alone. If the store is unreachable the API keeps limiting in memory.
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379
